# Copy this file to .env and fill in your own keys. Never commit .env.
# You can also fill these in later from Aura's Settings panel.

# --- AI models (free keys) ---
# Groq: https://console.groq.com/keys  (main model for most agents)
GROQ_API_KEY=
# A second Groq key, so the Orchestrator/System/Inbox agents get their own rate limit (can be the same key)
GROQ_API_KEY_SYSTEM=
# Gemini: https://aistudio.google.com/apikey  (backup model)
GEMINI_API_KEY=
# OpenRouter: https://openrouter.ai/keys  (last-resort free models)
OPENROUTER_API_KEY=

# --- Web search (Web + Music agents) ---
# Tavily: https://tavily.com  (1,000 free searches a month)
TAVILY_API_KEY=

# --- Email (Mailer + Inbox agents, optional) ---
# Use a 16-letter Gmail App Password, NOT your normal password:
# turn on 2-Step Verification, then create one at https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# Your name, used to sign emails and in the greeting
USER_NAME=

# --- Notion agent (optional) ---
# notion.so/profile/integrations -> New integration -> Internal Integration Secret
NOTION_TOKEN=
